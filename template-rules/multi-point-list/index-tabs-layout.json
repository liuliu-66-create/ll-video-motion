    "textBox": {"width": 560, "height": 150},
    "requiredChecks": ["four-item-layout", "six-item-layout", "each-number-center", "each-text-center"]
  },
  "itemCountLayouts": {
    "2": "two centered columns",
    "3": "two above and one centered below",
    "4": "two columns by two rows",
    "5": "two-two-one compact grid",
    "6": "two columns by three rows"
  },
  "animation": "backing paper settles; each label enters; number stamps in; keyword follows",
  "textRule": "center-on-label-safe-area; shrink-only; never-shift-center"
